---
import Layout from '../layouts/Layout.astro';

const base = import.meta.env.BASE_URL;
---

<Layout title="Página no encontrada | Consultoría Bastías">
  <div style="min-height: 100vh; display: flex; align-items: center; justify-content: center; text-align: center; padding: 2rem;">
    <div>
      <p style="font-family: var(--font-display); font-size: 8rem; color: var(--color-accent); opacity: 0.3; line-height: 1; margin-bottom: 1rem;">404</p>
      <h1 style="font-size: 2rem; margin-bottom: 1rem;">Página no encontrada</h1>
      <p style="color: var(--color-text-muted); margin-bottom: 2rem;">La página que buscás no existe o fue movida.</p>
      <a href={base} class="btn btn-solid">Volver al inicio</a>
    </div>
  </div>
</Layout>
